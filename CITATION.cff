    given-names: Ragavi
    affiliation: "Fraunhofer IAIS"
  - family-names: Piatkowski
    given-names: Nico
    affiliation: "Fraunhofer IAIS"
repository-code: "https://github.com/lklee9/k-order-Markov-blanket"
url: "https://lklee.dev/k-order-Markov-blanket"
# The paper is accepted at UAI 2026, but the proceedings are not published yet,
# so the preferred citation points at the arXiv preprint. Switch this back to
# type: conference-paper with a collection-title once they appear.
preferred-citation:
  type: article
  title: "High-Order Markov Blanket Discovery via a k-Order Relaxation of the Faithfulness Assumption"
  year: 2026
  notes: "arXiv preprint; accepted at the Conference on Uncertainty in Artificial Intelligence (UAI) 2026, proceedings not yet published."
